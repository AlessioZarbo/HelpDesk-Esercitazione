{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "helpdesk-auth",
    "Audience": "helpdesk-api",
    "SigningKey": "dev-only-helpdesk-key-change-me-0123456789abcdef",
    "ExpiresMinutes": 120
  },
  "FixHours": {
    "Low": 72,
    "Medium": 24,
    "High": 8,
    "Critical": 4
  }
}
